	column Discount_pct
		dataType: int64
		formatString: 0
		lineageTag: 91efbf94-0d70-46eb-8bc9-6e9744df4634
		summarizeBy: sum
		sourceColumn: Discount_pct

		annotation SummarizationSetBy = Automatic

	column Invoice = ```
			
			IF (
			    'file'[Coupon_Status] = "Used",
			    (
			        ('file'[Quantity] * 'file'[Avg_Price]) 
			        * (1 - 'file'[Discount_pct] / 100)
			        * (1 + 'file'[GST])
			    ) + 'file'[Delivery_Charges],
			    (
			        ('file'[Quantity] * 'file'[Avg_Price]) 
			        * (1 + 'file'[GST])
			    ) + 'file'[Delivery_Charges]
			)
			
			```
		lineageTag: 62db05c7-d66a-4296-9d16-b2c5326d82f7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}


		annotation SummarizationSetBy = Automatic

	column Season =
			
			SWITCH(
			    TRUE(),
			    file[Month] IN {12, 1, 2}, "Winter",
			    file[Month] IN {3, 4, 5}, "Spring",
			    file[Month] IN {6, 7, 8}, "Summer",
			    file[Month] IN {9, 10, 11}, "Autumn",
			    BLANK()
			)
		lineageTag: 33caae88-1a70-4610-ad97-f9e38590751d
		summarizeBy: none
		sortByColumn: SeasonOrder

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column SeasonOrder =
			
			SWITCH(
			    TRUE(),
			    file[Month] IN {12, 1, 2}, 4,
			    file[Month] IN {3, 4, 5}, 1,
			    file[Month] IN {6, 7, 8}, 2,
			    file[Month] IN {9, 10, 11}, 3
			)
		formatString: 0
		lineageTag: 9c27493c-7086-4371-8d4c-b995e3a9f63b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Snapshot_Date = CALCULATE(MAX('file'[Transaction_Date]), ALL('file'))
